              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/projects/:projectId/members",
              "host": ["{{base_url}}"],
              "path": ["projects", ":projectId", "members"],
              "variable": [
                {
                  "key": "projectId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Remove Project Member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/projects/:projectId/members/:memberId",
              "host": ["{{base_url}}"],
              "path": ["projects", ":projectId", "members", ":memberId"],
              "variable": [
                {
                  "key": "projectId",
                  "value": ""
                },
                {
                  "key": "memberId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
