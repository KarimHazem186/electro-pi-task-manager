{
  "info": {
    "name": "Task Manager - Image Upload API (ElectroPi)",
    "description": "API endpoints for uploading images to Cloudinary for ElectroPi Task Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Single Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "folder",
                  "value": "task-manager/test",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "image"]
            },
            "description": "Upload a single image to Cloudinary"
          },
          "response": []
        },
        {
          "name": "Upload Multiple Images",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "folder",
                  "value": "task-manager/test",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/images",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "images"]
            },
            "description": "Upload multiple images to Cloudinary (max 10)"
          },
          "response": []
        },
        {
          "name": "Upload Profile Picture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "profile"]
            },
            "description": "Upload profile picture (automatically saved to task-manager/profiles folder)"
          },
          "response": []
        },
        {
          "name": "Upload Task Attachment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/task-attachment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "task-attachment"]
            },
            "description": "Upload task attachment (automatically saved to task-manager/task-attachments folder)"
          },
          "response": []
        },
        {
          "name": "Delete Image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicId\": \"task-manager/test/sample_image_id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload", "image"]
            },
            "description": "Delete an image from Cloudinary using publicId or url"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Token saved:\", jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amara@electropi.io\",\n  \"password\": \"Amara@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login to get JWT token with ElectroPi account (automatically saves token to collection variable)"
          },
          "response": []
        }
      ]
    }
  ]
}
